{
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "next",
      "next/core-web-vitals",
      "eslint:recommended",
      "plugin:react/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "react"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "react/no-unescaped-entities": "off",
      "react/prop-types": "off"
    }
  }
  